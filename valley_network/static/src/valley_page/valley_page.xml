<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="valley_network.ValleyPage">
        <div class="valley-page">
            <div class="valley-container">
                <!-- Valley Logo -->
                <div class="valley-logo">
                    <svg viewBox="0 0 396.84 369.06" xmlns="http://www.w3.org/2000/svg">
                        <path fill="#FFFFFF" d="M326.31,70l.53,74.86c.05,7.56-3.27,13.87-8.31,19.1l-74.14,77.05c-3.79,3.94-11,6.88-16.36,6.87l-55.71-.04c-6.21,0-13.11-3.21-17.48-7.6l-84.83-85.24,69.44-.33c4.25-.02,9.2,2.68,12.51,5.37l65.98,66.17c2.25,2.26,8.49,2.07,11.06.51,2.28-1.38,5.08-5.68,5.07-8.98l-.06-48c0-4.16,1.89-9.63,5.03-12.76l87.27-86.99Z"/>
                        <path fill="#FFFFFF" d="M326.59,290.74l-.14,8.33H119.91c-9.75-1.17-14.91-9.1-14.85-18.31l.29-14.48h198.41c12.61,1.14,22.87,11.04,22.82,24.46Z"/>
                    </svg>
                </div>

                <!-- Tagline -->
                <h1 class="valley-tagline">Built by builders. For builders.</h1>

                <!-- Description -->
                <p class="valley-description">
                    A European professional network where companies say what they need right now and find the right people.
                </p>

                <!-- Benefits -->
                <div class="valley-benefits">
                    <div class="valley-benefit">
                        <span class="valley-benefit-icon">🤝</span>
                        <span class="valley-benefit-text">Find partners</span>
                    </div>
                    <div class="valley-benefit">
                        <span class="valley-benefit-icon">👥</span>
                        <span class="valley-benefit-text">Hire talent</span>
                    </div>
                    <div class="valley-benefit">
                        <span class="valley-benefit-icon">💰</span>
                        <span class="valley-benefit-text">Meet investors</span>
                    </div>
                </div>

                <!-- Join Button -->
                <button class="valley-join-btn" t-on-click="joinValley">
                    Join Valley
                </button>
            </div>
        </div>
    </t>
</templates>
